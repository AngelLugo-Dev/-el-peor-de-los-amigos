---
import "../styles/global.css";
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0d0d12" />
  <title>Amigos de Mierda</title>
</head>
<body class="h-dvh touch-manipulation overflow-hidden bg-[radial-gradient(1100px_600px_at_50%_-10%,#1A4976_0%,#0E2338_60%)] text-ink antialiased select-none">
  <main class="mx-auto flex h-dvh w-full max-w-[520px] flex-col px-4 pb-[max(.75rem,env(safe-area-inset-bottom))] pt-3" id="app"></main>
  <div class="toast rounded-full bg-surface px-5 py-3 text-[.9rem] font-extrabold text-dark shadow-xl" id="toast"></div>
  <script>
    import { nuevaPartida, marcar, deshacer, siguiente } from "../../src/game.ts";

    const KEY = "adm-amigos-v2";
    // ponytail: el script es client-side (innerHTML), Astro no reescribe la base → BASE_URL manual
    const BASE = import.meta.env.BASE_URL;
    const $ = (sel) => document.querySelector(sel);
    const root = $("#app");
    const toastEl = $("#toast");

    let partida = load();
    let setup = { nombres: [], umbral: 5 };
    let draft = "";

    function load() {
      try { return JSON.parse(localStorage.getItem(KEY)); } catch { return null; }
    }
    function save(p) { localStorage.setItem(KEY, JSON.stringify(p)); }
    function clearGame() { localStorage.removeItem(KEY); partida = null; render(); }
    function toast(msg) {
      toastEl.textContent = msg;
      toastEl.classList.add("on");
      clearTimeout(toastEl._t);
      toastEl._t = setTimeout(() => toastEl.classList.remove("on"), 1500);
    }
    const esc = (s) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

    function render() {
      if (!partida) renderSetup();
      else if (partida.ganador) renderFin();
      else renderJuego();
    }
    render();

    // ponytail: el resultado llega cuando alguien alcanza el umbral = EL AMIGO DE MIERDA. Sin eliminaciones.
    function renderSetup() {
      root.innerHTML = `
        <header class="flex flex-col items-center pt-1">
          <div class="flex w-full shrink-0 items-center justify-center overflow-hidden">
            <img src="${BASE}logo.png" alt="Amigos de Mierda" class="max-h-28 w-auto max-w-full object-contain">
          </div>
          <div class="mt-1 text-sm text-mute">El juego del peor de todos</div>
        </header>
        <div class="anim-rise mt-3 flex min-h-0 flex-1 flex-col">
          <label for="nombre" class="text-[.85rem] font-extrabold uppercase tracking-widest text-ink">Agregar jugadores</label>
          <div class="mt-1.5 flex gap-2">
            <input id="nombre" class="h-12 flex-1 rounded-xl border border-line/40 bg-panel px-4 text-ink outline-none placeholder:text-mute focus:border-transparent focus:ring-2 focus:ring-gold" placeholder="Nombre del jugador" autocomplete="off" maxlength="18" value="${esc(draft)}">
            <button class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-gold text-3xl font-black leading-none text-dark transition active:scale-90" id="add" aria-label="Añadir jugador">+</button>
          </div>
          <div class="mt-3 min-h-8 max-h-24 overflow-y-auto" id="chips"></div>
          <div class="mb-2 mt-auto pt-3 text-center">
            <label class="text-[1.05rem] font-extrabold text-ink">Límite de puntos</label>
            <div class="mt-2 flex items-center justify-center gap-4">
              <button class="grid h-12 w-12 place-items-center rounded-xl border-2 border-gold/60 bg-panel text-2xl font-bold text-ink transition active:scale-90" id="menos" aria-label="Menos">−</button>
              <b class="min-w-9 text-center text-[2rem] font-black tabular-nums text-gold" id="umbral">${setup.umbral}</b>
              <button class="grid h-12 w-12 place-items-center rounded-xl bg-acc text-2xl font-bold text-white transition active:scale-90" id="mas" aria-label="Más">+</button>
            </div>
          </div>
          <button class="w-full rounded-2xl bg-acc py-4 text-lg font-extrabold text-white transition active:scale-[.98] disabled:opacity-35" id="empezar">Empezar partida (${setup.nombres.length})</button>
        </div>`;

      const input = $("#nombre");
      $("#add").onclick = addJugador;
      input.onkeydown = (e) => { draft = input.value; if (e.key === "Enter") e.preventDefault(), addJugador(); };
      input.oninput = () => { draft = input.value; };
      $("#mas").onclick = () => { setup.umbral = Math.min(20, setup.umbral + 1); $("#umbral").textContent = setup.umbral; };
      $("#menos").onclick = () => { setup.umbral = Math.max(2, setup.umbral - 1); $("#umbral").textContent = setup.umbral; };

      function addJugador() {
        const v = input.value.trim();
        if (!v) return;
        if (setup.nombres.includes(v)) return toast("Ese nombre ya existe");
        setup.nombres.push(v);
        input.value = ""; draft = "";
        renderChips();
        toast(v + " añadido");
        input.focus();
      }
      function renderChips() {
        $("#chips").innerHTML = setup.nombres.map(n => `<span class="anim-pop flex items-center gap-2 rounded-2xl border border-gold/30 bg-panel py-1 pl-1 pr-2 font-bold">
          <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-gold/25 text-sm font-black text-gold uppercase">${esc(n[0])}</span>
          <span class="truncate text-[.85rem] max-w-[8.5rem]">${esc(n)}</span>
          <button class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-panel border border-line/30 text-sm text-mute transition active:scale-90" data-x="${esc(n)}" aria-label="Quitar ${esc(n)}">×</button>
        </span>`).join("");
        $("#chips").querySelectorAll("button").forEach(b => b.onclick = () => {
          setup.nombres = setup.nombres.filter(n => n !== b.dataset.x);
          renderChips();
          updateStart();
        });
        updateStart();
      }
      function updateStart() {
        const b = $("#empezar");
        b.disabled = setup.nombres.length < 2;
        b.textContent = setup.nombres.length < 2 ? "Necestas al menos 2 jugadores" : `Empezar partida (${setup.nombres.length})`;
      }
      $("#empezar").onclick = () => {
        partida = nuevaPartida(setup.nombres, setup.umbral);
        setup = { nombres: [], umbral: 5 };
        save(partida);
        render();
      };
      renderChips();
      input.focus();
    }

    function renderJuego() {
      const p = partida;
      const lector = p.jugadores[p.lector];
      const palo = ["♠", "♥", "♣", "♦"][p.indiceMazo % 4];
      root.innerHTML = `
        <header class="flex items-center justify-between">
          <div>
            <div class="text-[.95rem] font-extrabold tracking-wider"><b>AMIGOS DE MIERDA</b></div>
            <div class="mt-0.5 text-[.8rem] text-mute">Lee: <b class="text-gold">${esc(lector.nombre)}</b> · Ronda ${p.ronda}</div>
          </div>
          <button class="rounded-lg border border-line/40 bg-transparent px-2 py-1 text-xs font-bold text-mute transition active:scale-95" id="reset">Reiniciar</button>
        </header>
        <div class="anim-flip relative mt-3 flex min-h-0 flex-1 flex-col justify-between overflow-hidden rounded-[22px] border-4 border-gold/50 bg-panel text-[1.02rem] font-bold leading-relaxed shadow-[0_20px_50px_-20px_rgba(0,0,0,.7)]">
          <img src="${BASE}carta.png" alt="" aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-full object-cover" onerror="this.remove()">
          <span class="absolute left-3 top-2 z-10 text-2xl text-gold drop-shadow-[0_1px_3px_rgba(0,0,0,.7)]">${palo}</span>
          <span class="absolute bottom-2 right-3 z-10 rotate-180 text-2xl text-gold drop-shadow-[0_1px_3px_rgba(0,0,0,.7)]">${palo}</span>
          <div class="relative z-10 flex h-full items-center overflow-y-auto pt-5">
            <div class="rounded-2xl bg-surface/90 p-3 text-[1.02rem] font-bold leading-relaxed text-dark shadow-lg">${esc(p.cartaActual)}</div>
          </div>
          <div class="relative z-10 mt-3 flex items-center justify-between text-[.7rem] font-extrabold uppercase tracking-wider opacity-60 text-ink"><span>${esc(lector.nombre)} lee</span><span class="tabular-nums">${palo} ${p.indiceMazo + 1}/${p.mazoBarajado.length}</span></div>
        </div>
        <div class="mt-2 text-[.78rem] text-mute">Todos señalan a su elegido: <b class="text-ink">toca una vez por ronda</b> al más señalado. Alcanzar <b class="text-gold">${p.umbral}</b> lo corona <b class="text-gold">EL AMIGO DE MIERDA</b>.</div>
        <div class="mt-2 grid grid-cols-2 gap-2" id="players">${p.jugadores.map((j, i) => {
          const pct = Math.min(100, Math.round((j.puntos / p.umbral) * 100));
          const borde = i === p.lector ? "border-gold" : "border-line/40";
          return `<div class="jugador relative flex cursor-pointer select-none flex-col gap-1 rounded-xl border-2 bg-panel p-2.5 transition active:scale-95 ${borde}" data-i="${i}">
            <div class="truncate text-[.9rem] font-bold">${esc(j.nombre)}</div>
            <div class="h-1.5 overflow-hidden rounded-full bg-bg/70"><i class="block h-full rounded-full bg-acc transition-[width] duration-300" style="width:${pct}%"></i></div>
            <div class="text-xs text-mute tabular-nums">${j.puntos}/${p.umbral}</div>
          </div>`;
        }).join("")}</div>
        <div class="mt-2.5 grid grid-cols-2 gap-2.5">
          <button class="rounded-xl border border-line/40 bg-panel py-3.5 text-[.95rem] font-extrabold text-ink transition active:scale-95" id="back">Deshacer último</button>
          <button class="rounded-xl bg-acc py-3.5 text-[.95rem] font-extrabold text-white transition active:scale-95" id="next">Siguiente carta</button>
        </div>`;

      $("#players").onclick = (e) => {
        const el = e.target.closest(".jugador");
        if (!el) return;
        const j = p.jugadores[+el.dataset.i];
        if (p.ganador) return;
        if (p.marcado) return toast("Ya señalaste en esta ronda");
        marcar(p, j.nombre);
        save(p);
        if (p.ganador) { toast("El amigo de mierda existe"); render(); return; }
        toast("+1 " + j.nombre);
        render();
      };
      $("#next").onclick = () => { siguiente(p); save(p); render(); };
      $("#back").onclick = () => {
        if (!p.historial.length) return toast("Nada para deshacer");
        deshacer(p, p.historial.pop());
        save(p);
        render();
        toast("Deshecho");
      };
      $("#reset").onclick = () => { if (confirm("Reiniciar el juego?")) clearGame(); render(); };
    }

    // ponytail: pantalla de resultado = el que alcanzó el umbral se corona amigo de mierda
    function renderFin() {
      const p = partida;
      root.innerHTML = `
        <section class="anim-pop flex flex-1 flex-col items-center justify-center gap-1 pt-2 text-center">
          <div class="anim-copo text-[3rem] leading-none">💩</div>
          <h2 class="text-[1.35rem] font-extrabold leading-tight text-gold">${esc(p.ganador)} es<br>EL AMIGO DE MIERDA</h2>
          <p class="text-[.8rem] text-mute">Alcanzó ${p.umbral} señalamientos. El peor de todos.</p>
        </section>
        <div class="anim-rise grid grid-cols-1 gap-2">
          ${p.jugadores.map(j => `
            <div class="flex items-center justify-between rounded-xl border-2 bg-panel px-3.5 py-2.5 ${j.nombre === p.ganador ? "border-gold shadow-[0_0_24px_rgba(221,161,54,.3)]" : "border-line/40"}">
              <div class="font-bold ${j.nombre === p.ganador ? "text-gold" : ""}">${esc(j.nombre)}</div>
              <div class="text-xs text-mute tabular-nums">${j.puntos} / ${p.umbral} puntos</div>
            </div>`).join("")}
        </div>
        <button class="mt-3 w-full rounded-xl bg-acc py-3.5 font-extrabold text-white transition active:scale-95" id="otra">Jugar otra vez</button>`;
      $("#otra").onclick = () => { clearGame(); render(); };
    }
  </script>
</body>
</html>